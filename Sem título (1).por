programa {
  funcao inicio() {
    
  real nota1 , nota2, nota3, nota4 ,media, total

  digite("Digite nota 1: ")
  leia(nota1)

  digite("Digite nota 2: ")
  leia(nota2)

  digite("Digite nota 3: ")
  leia(nota3)

  digite("Digite nota 4: ")
  leia(nota4)

  media=nota1+nota2+nota3+nota4

  total=media/4

}
}
